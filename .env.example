GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_TAB=Registrations
# Local: absolute path to the private JSON key outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/your-name/.config/kampi/google-service-account.json
# Hosting: set GOOGLE_SERVICE_ACCOUNT_JSON to the full JSON key as a server-only
# secret instead of GOOGLE_APPLICATION_CREDENTIALS. Never use NEXT_PUBLIC_.
